<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- List View -->
    <record id="view_raw_attendance_list" model="ir.ui.view">
        <field name="name">attendance.raw.list</field>
        <field name="model">attendance.raw</field>
        <field name="arch" type="xml">
            <list string="Raw Attendance">
                <field name="employee_code"/>
                <field name="timestamp"/>
                <field name="device_id"/>
                <field name="source"/>
                <field name="mapping_id"/>
                <field name="processed"/>
                <field name="import_date"/>
            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="view_raw_attendance_form" model="ir.ui.view">
        <field name="name">attendance.raw.form</field>
        <field name="model">attendance.raw</field>
        <field name="arch" type="xml">
            <form string="Raw Attendance">

                <sheet>

                    <group>

                        <group>
                            <field name="employee_code"/>
                            <field name="timestamp"/>
                            <field name="device_id"/>
                            <field name="source"/>
                        </group>

                        <group>
                            <field name="import_date"/>
                            <field name="processed"/>
                            <field name="mapping_id"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Notes">
                            <field name="note"/>
                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="action_raw_attendance" model="ir.actions.act_window">
        <field name="name">Raw Attendance</field>
        <field name="res_model">attendance.raw</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Menu -->
    <menuitem
        id="menu_raw_attendance"
        name="Raw Attendance"
        parent="menu_attendance_management_root"
        action="action_raw_attendance"
        sequence="20"
    />

</odoo>
