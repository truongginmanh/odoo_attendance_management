<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- List View -->
    <record id="view_attendance_device_list" model="ir.ui.view">
        <field name="name">attendance.device.list</field>
        <field name="model">attendance.device</field>
        <field name="arch" type="xml">
            <list string="Attendance Devices">
                <field name="name"/>
                <field name="device_code"/>
                <field name="ip_address"/>
                <field name="port"/>
                <field name="status"/>
                <field name="last_sync"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="view_attendance_device_form" model="ir.ui.view">
        <field name="name">attendance.device.form</field>
        <field name="model">attendance.device</field>
        <field name="arch" type="xml">
            <form string="Attendance Device">

                <sheet>

                    <group>

                        <group>
                            <field name="name"/>
                            <field name="device_code"/>
                            <field name="ip_address"/>
                            <field name="port"/>
                        </group>

                        <group>
                            <field name="status"/>
                            <field name="active"/>
                            <field name="last_sync"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Notes">
                            <field name="note"/>
                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="action_attendance_device" model="ir.actions.act_window">
        <field name="name">Attendance Devices</field>
        <field name="res_model">attendance.device</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Menu -->
    <menuitem
        id="menu_attendance_device"
        name="Devices"
        parent="menu_attendance_management_root"
        action="action_attendance_device"
        sequence="5"
    />

</odoo>